{
	// The andorlabs.ca Worker: Astro's static pages as assets, plus the
	// on-demand routes in src/pages/api/. Replaced the Pages project
	// `andorlabs` on 2026-11-04 so RoutingCat's Worker can run before pages.
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "andorlabs",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"main": "src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Legacy paths in public/_redirects are excluded so the asset layer
		// answers them with their 301s; a Worker-first request would get the
		// target's content with a 200 instead. Keep in sync with src/worker.ts.
		"run_worker_first": ["/*", "!/_astro/*", "!/tools", "!/tools/*", "!/admin", "!/admin/*", "!/work", "!/work/*", "!/blog", "!/blog/*", "!/about", "!/contact", "!/faq", "!/pricing", "!/login", "!/signup", "!/privacy", "!/lab", "!/lab/", "!/experiments", "!/experiments/", "!/published", "!/published/", "!/gtm", "!/gtm/"]
	},
	// Brief cache, rate limit and Exa spend counter (src/pages/api/brief.ts).
	// Same namespace the Pages project bound, so cached briefs carry over.
	"kv_namespaces": [{ "binding": "BRIEF", "id": "37b1291b169e4b648eb518231a26f0b9" }],
	// Zone routes rather than custom domains: they take the hostnames over from
	// the Pages project with no DNS change and no gap in service.
	"routes": [
		{ "pattern": "andorlabs.ca/*", "zone_name": "andorlabs.ca" },
		{ "pattern": "www.andorlabs.ca/*", "zone_name": "andorlabs.ca" }
	],
	"observability": {
		"enabled": true
	},
	"version_metadata": { "binding": "CF_VERSION_METADATA" }
}
