---
import { ClientRouter } from "astro:transitions";

import "../styles/site.css";
import "../styles/consent.css";
import Cta from "../components/Cta.astro";
import CopyDiffer from "../components/CopyDiffer.astro";
import Icon from "../components/Icon.astro";
import Subscribe from "../components/Subscribe.astro";
import { book, FDM, HOME, MENU, SITE, SOCIALS, tone, type Color, type Fig } from "../data/site";
import { RoutingCat } from "routingcat/astro/components";

interface Props {
  title?: string;
  description?: string;
  fig: Fig;
  color?: Color;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  variant?: "index" | "document";
  /** False on pages that carry their own subscribe form, so each page has exactly one. */
  subscribe?: boolean;
}
const { title, description = SITE.description, fig, color = "blue", image = "/og-image.jpg", type = "website", publishedTime, variant = "document", subscribe = true } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const isHome = Astro.url.pathname === "/";
---
<!doctype html>
<html lang="en" data-home={isHome ? "" : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <RoutingCat />
  <meta name="theme-color" content="#1b4dff" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon/favicon.ico" sizes="48x48" />
  <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title="And/or Labs Transmissions" href="/rss.xml" />
  <link rel="preload" href="/fonts/paper-mono/PaperMono.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:creator" content="@eclecticV" />
  <slot name="head" />
  <ClientRouter fallback="swap" />
</head>
<body>
  <nav aria-label="Skip links"><a class="skip" href="#main">Skip to content</a></nav>
  <div class:list={["sheet", variant, { reading: type === "article" }]}>
    <div class="frame">
      <header class="topbar" transition:persist="topbar">
        <a class="brand" href="/" aria-label={`${SITE.name}, home`}>
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="7" fill="currentColor" /><path d="M20.75 8 L11.25 24" stroke="#fff" stroke-width="3.25" stroke-linecap="round" /></svg>
          <span class="brand-name">And/or Labs</span>
        </a>
        <nav class="topnav" aria-label="Lines of work">
          {MENU.map(m => <a href={m.href} data-menu-key={m.n} aria-current={Astro.url.pathname.startsWith(m.href) ? "page" : undefined}>{m.label}</a>)}
        </nav>
        <Cta href={book("top-bar")} label="Book a call" meta="30 min" external />
      </header>
      <main id="main" class="pane" tabindex="-1" data-fig={fig} style={tone(color)}>
        <div class="ruler" aria-hidden="true">{Array.from({ length: 12 }, (_, i) => <span>{i * 120}</span>)}</div>
        <header class="pane-head"><slot name="crumb" /></header>
        <slot />
      </main>
      <aside class="viz" transition:persist="figure" aria-label="Figure: inference">
        <div class="ao"><iframe src="/fig/engine.html" title="A bare high-bypass turbofan pod, floating: fan at the front, thrust out the back" loading="lazy"></iframe></div>
        <!-- Home only (CSS). Rendered on every page because the aside persists across navigation; display:none keeps the lazy iframe from loading elsewhere. -->
        <div class="pc"><iframe src="/fig/computer.html" title="An old desk computer with a deep screen and a keyboard on a coiled cable. Type on it and the keys go down." loading="lazy"></iframe></div>
      </aside>
      <div class="after"><slot name="after" /></div>
      <footer class="site-footer">
        <div class="foot-brand">
          <a class="brand" href="/" aria-label={`${SITE.name}, home`}>
            <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="7" fill="currentColor" /><path d="M20.75 8 L11.25 24" stroke="#fff" stroke-width="3.25" stroke-linecap="round" /></svg>
            <span class="brand-name">And/or Labs</span>
          </a>
          <p class="foot-line">{HOME.title}.</p>
          <Cta href={book("footer")} label="Book a call" meta="30 min" external />
        </div>
        <nav class="foot-cols" aria-label="Site map">
          <div>
            <p class="label">Consulting</p>
            <ul>
              {FDM.pillars.map(p => <li><a href={`/fdm/#${p.id}`}>{p.name}</a></li>)}
              <li><a href="/fdm/#offer">Pricing</a></li>
            </ul>
          </div>
          <div>
            <p class="label">Transmissions</p>
            <ul>
              <li><a href="/notes/">All transmissions</a></li>
              <li><a href="/notes/#experiments">Experiments</a></li>
              <li><a href="https://sliceofadtech.buzzsprout.com/2043731/episodes" target="_blank" rel="noopener" aria-label="Slice of AdTech, opens in a new tab">Slice of AdTech</a></li>
              <li><a href="/rss.xml">RSS</a></li>
            </ul>
          </div>
          <div>
            <p class="label">On the record</p>
            <ul>
              <li><a href="/record/#bylines">Bylines</a></li>
              <li><a href="/record/#earned">Coverage</a></li>
              <li><a href="/record/#citations">Citations</a></li>
              <li><a href="/record/#podcast">Podcast</a></li>
            </ul>
          </div>
        </nav>
        {subscribe && <div class="foot-sub"><Subscribe source="footer" /></div>}
        <div class="foot-base">
          <span class="label">© {new Date().getFullYear()} And/or Labs Inc. HQ, Calgary, AB.</span>
          <nav class="elsewhere" aria-label="Elsewhere">
            {SOCIALS.map(s => (
              <a href={s.href} {...(s.id === "email" ? {} : { target: "_blank", rel: "noopener" })} aria-label={s.label}><Icon name={s.id} /></a>
            ))}
          </nav>
        </div>
      </footer>
    </div>
  </div>
  {import.meta.env.DEV && <CopyDiffer />}
  <script>
    import "../scripts/site.ts";
    import "../scripts/conversions.ts";
    if (import.meta.env.DEV) import("../scripts/agentation-dev");
  </script>
</body>
</html>
