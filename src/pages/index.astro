---
import { getCollection } from "astro:content";

import Cta from "../components/Cta.astro";
import NotePreview from "../components/NotePreview.astro";
import Section from "../components/Section.astro";
import Testimonials from "../components/Testimonials.astro";
import { book, FDM, GRANTS, HOME } from "../data/site";
import Sheet from "../layouts/Sheet.astro";

const [before, after] = HOME.title.split(HOME.emphasis);
const latest = (await getCollection("blog", p => !p.data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---
<Sheet fig="ripple" variant="index">
  <h1 class="display">{before}<em>{HOME.emphasis}</em><span class="rest">{after}</span></h1>
  <p class="founder">Founded by Vishveshwar Jatain, former marketing head of AdPushup (acquired by Geniee, Inc.) and Blockthrough (acquired by eyeo GmbH)</p>
  <dl class="proof proof-top" aria-label="Supported by">
    <div class="proof-inline">
      <dt class="label">Supported by</dt>
      <dd>
        <ul class="partners grants">
          {GRANTS.map(g => <li><img src={g.src} alt={g.name} height={g.h} style={`--h:${g.h}px`} loading="lazy" decoding="async" /></li>)}
        </ul>
      </dd>
    </div>
  </dl>

  <nav class="home-menu" aria-label="Consulting pillars">
    <ol class="menu commercial-menu">
      {FDM.pillars.map((p, i) => (
        <li><a href={`/fdm/#${p.id}`} data-n={i + 1}>
          <span class="br" aria-hidden="true">[{i + 1}]</span>
          <span class="t">{p.name}</span><span class="hint">{p.work}</span>
          <span class="go" aria-hidden="true">→</span>
        </a></li>
      ))}
    </ol>
  </nav>

  <Fragment slot="after">
    <div class="home-more">
      <Testimonials />

      <Section id="transmissions" label="Latest transmissions" count={latest.length}>
        <div class="note-grid">
          {latest.map(p => (
            <NotePreview id={`home-${p.id}`} label={p.data.category === "resources" ? "Resource" : "Field note"} title={p.data.title} description={p.data.standfirst ?? p.data.description} href={`/notes/${p.id}/`} cta="Read" image={p.data.heroImage} imageAlt={p.data.heroAlt} date={p.data.pubDate} loading="lazy" />
          ))}
        </div>
        <p class="sec-foot"><a class="text-link" href="/notes/">All transmissions <span aria-hidden="true">→</span></a></p>
      </Section>

      <Section id="book" label="Next step">
        <div class="home-close">
          <p class="lead-line">{FDM.offer.for}</p>
          <p class="price-line"><b>{FDM.offer.price}</b> {FDM.offer.term} · {FDM.offer.commitment}</p>
          <div class="ctas"><Cta href={book("homepage")} label={FDM.offer.cta} meta="30 min" external /></div>
        </div>
      </Section>
    </div>
  </Fragment>
</Sheet>
